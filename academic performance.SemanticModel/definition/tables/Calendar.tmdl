	partition Calendar = calculated
		mode: import
		source =
				
				ADDCOLUMNS(
				CALENDAR(
				MIN(grades[grade_date]),
				MAX(grades[grade_date])
				),
				"Year", YEAR([Date]),
				"Month", FORMAT([Date], "MMMM"),
				"Month Number", MONTH([Date]),
				"Year-Month", FORMAT([Date], "YYYY-MM")
				)

